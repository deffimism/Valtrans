<Window x:Class="Valtrans.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valtrans · Game Chat Translator" Icon="Assets/Valtrans-mark.png" Width="1340" Height="900" MinWidth="1080" MinHeight="720"
        Background="{DynamicResource PageBrush}" Foreground="#0F172A" FontFamily="{StaticResource AppFontFamily}" WindowStartupLocation="CenterScreen" Loaded="Window_OnLoaded" Closing="Window_OnClosing"
        PreviewKeyDown="Window_OnPreviewKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Dashboard.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Background="{StaticResource PageBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#E2E7F0" BorderThickness="0,0,1,0" Padding="16,28,16,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="6,0,0,32">
            <Image Source="Assets/Valtrans-mark.png" Width="40" Height="40" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="Fant"/>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="valtrans" FontSize="22" FontWeight="Bold"/><TextBlock Text="게임 채팅 번역" FontSize="12" Foreground="#64748B" Margin="1,3,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Text="워크스페이스" FontSize="12" Foreground="#64748B" FontWeight="SemiBold" Margin="16,0,0,10"/>
          <RadioButton x:Name="OverviewNavigation" Style="{StaticResource NavigationItem}" GroupName="Pages" Tag="Overview" IsChecked="True" Click="DashboardNavigation_OnClick"><TextBlock Text="채팅 대시보드" Foreground="#0F172A"/></RadioButton>
          <RadioButton x:Name="AdvancedModeButton" Style="{StaticResource NavigationItem}" GroupName="Pages" Tag="Engines" Click="DashboardNavigation_OnClick"><TextBlock Text="번역 엔진" Foreground="#0F172A"/></RadioButton>
          <RadioButton x:Name="OverlayNavigation" Style="{StaticResource NavigationItem}" GroupName="Pages" Tag="Overlay" Click="DashboardNavigation_OnClick"><TextBlock Text="오버레이 설정" Foreground="#0F172A"/></RadioButton>
          <RadioButton x:Name="LabNavigation" Style="{StaticResource NavigationItem}" GroupName="Pages" Tag="Lab" Click="DashboardNavigation_OnClick"><TextBlock Text="번역 테스트 · 사전" Foreground="#0F172A"/></RadioButton>
          <Border Height="1" Background="#E2E7F0" Margin="12,22"/>
          <TextBlock Text="도움말" FontSize="12" Foreground="#64748B" FontWeight="SemiBold" Margin="16,0,0,10"/>
          <RadioButton x:Name="GuideNavigation" Style="{StaticResource NavigationItem}" GroupName="Pages" Tag="Guide" Click="DashboardNavigation_OnClick"><TextBlock Text="시작 가이드 · 점검" Foreground="#0F172A"/></RadioButton>
        </StackPanel>
            <Button DockPanel.Dock="Bottom" x:Name="FairySupportButton" Style="{StaticResource SupportImageButton}" Click="OpenFairySupport_OnClick" ToolTip="Fairy에서 Valtrans 후원하기">
              <Image Source="Assets/Valtrans-donate.png" Height="54" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#E2E7F0" BorderThickness="0,0,0,1" Padding="28,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="게임 채팅 워크스페이스" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#D1FAE5" BorderThickness="1" CornerRadius="16" Padding="12,7" Margin="12,0,16,0" VerticalAlignment="Center" MaxWidth="280">
            <DockPanel><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#059669" Margin="0,0,8,0"/>
              <TextBlock x:Name="TopStatusText" Text="준비됨" Foreground="#047857" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Border>
          <Button Grid.Column="2" Content="설정 저장" Style="{StaticResource PrimaryButton}" Click="SaveSettings_OnClick" VerticalAlignment="Center" Padding="18,10"/>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="28,28,28,24">
        <TextBlock x:Name="DashboardPageTitle" Text="채팅 대시보드" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="DashboardPageDescription" Text="보내는 말도, 팀원의 콜도. 익숙한 언어로 플레이하세요." FontSize="12" Foreground="#586A82" Margin="0,7,0,0"/>
      </StackPanel>
      <ScrollViewer x:Name="MainScrollViewer" Grid.Row="2" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,28">
        <StackPanel><Grid x:Name="OverviewPage" Margin="0,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>

          <Border Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource CardBorder}" Padding="22">
            <StackPanel>
              <TextBlock Text="보내는 채팅" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="채팅을 입력한 뒤 단축키 한 번" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,16"/>
              <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="번역 언어" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                  <ComboBox x:Name="SendTargetCombo"><ComboBoxItem Tag="EN"><TextBlock Style="{StaticResource ComboText}" Text="English"/></ComboBoxItem><ComboBoxItem Tag="JP"><TextBlock Style="{StaticResource ComboText}" Text="日本語"/></ComboBoxItem><ComboBoxItem Tag="KO"><TextBlock Style="{StaticResource ComboText}" Text="한국어"/></ComboBoxItem></ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2">
                  <TextBlock Text="단축키" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" Height="36" VerticalContentAlignment="Center"/>
                    <Button x:Name="CaptureHotkeyButton" Grid.Column="2" Content="입력" Padding="8,6" Click="CaptureHotkey_OnClick"/>
                  </Grid>
                </StackPanel>
              </Grid>
              <Border Background="#F8FAFD" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,2,0,0">
                <TextBlock x:Name="HotkeyHint" Text="\  →  전체 선택 · 번역 · 교체" Foreground="#18243B" FontSize="12"/>
              </Border>
              <TextBlock Text="단독 키도 가능하지만 일반 입력 중에도 작동할 수 있습니다. Enter는 직접 누르세요." Foreground="#586A82" FontSize="12" Margin="2,9,0,0" TextWrapping="Wrap"/>
            <Border BorderBrush="#E2E7F0" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,24,0,0">
  <StackPanel>
    <TextBlock Text="채팅 보내는 순서" FontWeight="SemiBold" FontSize="13"/>
    <TextBlock Text="1. 채팅창을 열고 문장 입력&#10;2. 번역 단축키 누르기&#10;3. 결과 확인 후 Enter" Foreground="#586A82" FontSize="12" LineHeight="26" Margin="0,10,0,0"/>
  </StackPanel>
</Border>
<Button Content="번역 먼저 테스트하기 →" Tag="Lab" Click="DashboardNavigation_OnClick" Margin="0,16,0,0"/>
</StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22">
            <StackPanel>
              <TextBlock Text="받는 채팅 · OCR" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="게임 영역을 읽어 번역문만 오버레이에 표시" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,14"/>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="OcrToggleButton" Style="{StaticResource PrimaryButton}" Content="OCR 시작" Click="OcrToggle_OnClick"/>
                <Button x:Name="OverlayToggleButton" Grid.Column="2" Content="오버레이 켜기" Click="ToggleOverlay_OnClick"/>
              </Grid>
              <Border x:Name="OcrIssuePanel" Visibility="Collapsed" Background="#FFF1F2" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,9,0,0">
                <TextBlock x:Name="OcrIssueText" Foreground="#B4233A" FontSize="12" TextWrapping="Wrap"/>
              </Border>

              <Grid Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="게임 · 채팅 영역" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                  <ComboBox x:Name="GameCombo" SelectionChanged="Game_OnSelectionChanged" ToolTip="게임 화면 비율로 채팅 영역을 계산하고 해당 게임의 용어 사전을 사용합니다.">
                    <ComboBoxItem Tag="Auto"><TextBlock Style="{StaticResource ComboText}" Text="게임 자동"/></ComboBoxItem>
                    <ComboBoxItem Tag="VALORANT"><TextBlock Style="{StaticResource ComboText}" Text="VALORANT"/></ComboBoxItem>
                    <ComboBoxItem Tag="Apex Legends"><TextBlock Style="{StaticResource ComboText}" Text="Apex Legends"/></ComboBoxItem>
                  </ComboBox>
                </Grid>
              </Grid>
              <Border Background="#F8FAFD" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock x:Name="RegionText" Text="저장된 영역이 없습니다" Foreground="#18243B" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="RegionHintText" Text="게임 화면 크기에 맞춰 추천 영역을 자동 적용합니다." TextWrapping="Wrap" Foreground="#586A82" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="추천 영역 새로고침" Padding="9,6" Margin="0,0,6,0" Click="RecommendRegion_OnClick"/>
                    <Button x:Name="OcrRegionPreviewButton" Content="OCR 영역 표시" Padding="9,6" Margin="6,0,0,0"
                            ToolTip="현재 OCR 영역을 하늘색 테두리로 표시합니다. 클릭은 통과하며 영역을 변경하지 않습니다."
                            Click="ToggleOcrRegionPreview_OnClick"/>
                  </StackPanel>
                </Grid>
              </Border>



                <TextBlock Text="번역 언어" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="#F5F7FB" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="8" Padding="9,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="원문" Foreground="#18243B" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="OcrEnCheck" Foreground="#18243B" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0" Checked="OcrLanguages_OnChanged" Unchecked="OcrLanguages_OnChanged"><TextBlock Text="EN" Foreground="#18243B"/></CheckBox>
                    <CheckBox x:Name="OcrJpCheck" Foreground="#18243B" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0" Checked="OcrLanguages_OnChanged" Unchecked="OcrLanguages_OnChanged"><TextBlock Text="JP" Foreground="#18243B"/></CheckBox>
                    <CheckBox x:Name="OcrKoCheck" Foreground="#18243B" FontSize="12" VerticalAlignment="Center" Checked="OcrLanguages_OnChanged" Unchecked="OcrLanguages_OnChanged"><TextBlock Text="KO" Foreground="#18243B"/></CheckBox>
                  </StackPanel>
                </Border>
                <ComboBox x:Name="OverlayTargetCombo" Grid.Column="2"><ComboBoxItem Tag="KO"><TextBlock Style="{StaticResource ComboText}" Text="출력 · 한국어"/></ComboBoxItem><ComboBoxItem Tag="EN"><TextBlock Style="{StaticResource ComboText}" Text="출력 · English"/></ComboBoxItem><ComboBoxItem Tag="JP"><TextBlock Style="{StaticResource ComboText}" Text="출력 · 日本語"/></ComboBoxItem></ComboBox>
              </Grid>
                <TextBlock Text="체크한 언어의 본문만 번역합니다. 한국어 UI도 구분해 읽으며, 출력 언어와 같은 채팅·시스템 문구·이미 처리한 줄은 건너뜁니다."
                         Foreground="#586A82" FontSize="12" TextWrapping="Wrap" Margin="1,-1,0,8"/>
              <Grid Margin="1,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Column="0" x:Name="LanguagePackStatusText" Text="OCR 언어팩 확인 중…" Foreground="#586A82" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="DetectedOcrLanguageText" Text="감지 대기" Foreground="#047857" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="130" Margin="8,0"/>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="TestOcrButton" Content="OCR 테스트" Padding="9,4" FontSize="12" Margin="0,0,6,0" Click="TestOcr_OnClick"/>
                  <Button x:Name="InstallLanguagePackButton" Content="언어팩" Padding="9,4" FontSize="12" Click="InstallLanguagePack_OnClick"/>
                </StackPanel>
              </Grid>
              <Expander x:Name="OcrDetailsPanel" Header="OCR 설정 · 진단" Margin="0,6,0,0">
                <StackPanel Margin="0,10,0,0">
              <Expander Header="채팅 필터 · OCR 세부 조정" Margin="0,0,0,12">
                <StackPanel Margin="0,10,0,0">
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="받는 채팅 필터" Foreground="#586A82" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="OcrChatFilterCombo" Width="160" Height="36" HorizontalAlignment="Right" Padding="7,2" SelectionChanged="OcrChatFilter_OnSelectionChanged" ToolTip="브리핑만은 위치·인원·피해량과 짧은 팀 소통만 남깁니다.">
                      <ComboBoxItem Tag="Briefing"><TextBlock Style="{StaticResource ComboText}" Text="브리핑만 · 권장"/></ComboBoxItem>
                      <ComboBoxItem Tag="All"><TextBlock Style="{StaticResource ComboText}" Text="잡담도 번역"/></ComboBoxItem>
                      <ComboBoxItem Tag="Strict"><TextBlock Style="{StaticResource ComboText}" Text="강한 필터 · 콜아웃만"/></ComboBoxItem>
                    </ComboBox>
                  </Grid>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OCR 채팅 안정화" Foreground="#586A82" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="OcrStabilityCombo" Width="105" Height="36" HorizontalAlignment="Right" Padding="7,2" SelectionChanged="OcrStability_OnSelectionChanged" ToolTip="글자가 완성될 때까지 기다리는 시간입니다. 균형을 먼저 사용하세요.">
                      <ComboBoxItem Tag="0"><TextBlock Style="{StaticResource ComboText}" Text="끔"/></ComboBoxItem>
                      <ComboBoxItem Tag="200"><TextBlock Style="{StaticResource ComboText}" Text="빠름"/></ComboBoxItem>
                      <ComboBoxItem Tag="350"><TextBlock Style="{StaticResource ComboText}" Text="균형"/></ComboBoxItem>
                      <ComboBoxItem Tag="500"><TextBlock Style="{StaticResource ComboText}" Text="안정"/></ComboBoxItem>
                      <ComboBoxItem Tag="700"><TextBlock Style="{StaticResource ComboText}" Text="매우 안정"/></ComboBoxItem>
                    </ComboBox>
                  </Grid>
                  <Grid Margin="0,9,0,0">
                    <CheckBox x:Name="OcrAutoEnhanceCheck" FontSize="12" IsChecked="True"
                              Checked="OcrQualityOptions_OnChanged" Unchecked="OcrQualityOptions_OnChanged"><TextBlock Text="작은 글자 자동 확대·대비 보정 · 권장" Foreground="#0F172A"/></CheckBox>
                  </Grid>
                  <Grid Margin="0,7,0,0">
                    <CheckBox x:Name="OcrConsensusCheck" FontSize="12" IsChecked="True"
                              Checked="OcrQualityOptions_OnChanged" Unchecked="OcrQualityOptions_OnChanged"><TextBlock Text="두 프레임 합의로 숫자·방향 흔들림 억제 · 권장" Foreground="#0F172A"/></CheckBox>
                  </Grid>
                  <TextBlock x:Name="OcrOptionHelpText" Text="권장 · 브리핑만은 잡담을 제외하고, 균형 안정화는 속도와 OCR 정확도를 함께 확보합니다."
                             Foreground="#586A82" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
              </Expander>
                <Expander x:Name="OcrEnginePanel" Header="OCR 엔진 · 고정확도 실험" Margin="0,0,0,12">
                  <StackPanel Margin="2,8,2,0">
                    <ComboBox x:Name="OcrEngineCombo" SelectionChanged="OcrEngine_OnChanged">
                      <ComboBoxItem Tag="Windows"><TextBlock Style="{StaticResource ComboText}" Text="Windows OCR · 가벼운 기본값"/></ComboBoxItem>
                      <ComboBoxItem Tag="Paddle"><TextBlock Style="{StaticResource ComboText}" Text="PaddleOCR-VL · 다국어 고정확도 · 실험"/></ComboBoxItem>
                    </ComboBox>
                    <TextBlock x:Name="PaddleOcrStatusText" Text="Windows OCR 사용 중" Foreground="#18243B" TextWrapping="Wrap" Margin="0,8,0,6"/>
                    <WrapPanel>
                      <Button x:Name="InstallPaddleOcrButton" Content="실행 환경 설치" Click="InstallPaddleOcr_OnClick" Padding="9,4" FontSize="12" Margin="0,0,6,6"/>
                      <Button x:Name="PreparePaddleOcrButton" Content="로컬 OCR 준비 · 확인" Click="PreparePaddleOcr_OnClick" Padding="9,4" FontSize="12" Margin="0,0,6,6"/>
                      <Button Content="실행 환경 폴더" Click="PaddleRuntime_OnClick" Padding="9,4" FontSize="12" Margin="0,0,6,6"/>
                      <Button Content="취소 · 메모리 해제" Click="ReleasePaddleOcr_OnClick" Padding="9,4" FontSize="12" Margin="0,0,6,6"/>
                      <Button Content="설치 가이드" Click="PaddleGuide_OnClick" Padding="9,4" FontSize="12" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="Paddle: 전체 채팅을 한·영·일 함께 읽습니다. 별도 설치·GPU 메모리 약 2GB가 필요하며 수 초 지연될 수 있습니다. OCR 중지 시 모델을 해제합니다. 이 모드는 이중 영역·두 프레임 검사를 사용하지 않습니다." Foreground="#586A82" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>
              <Expander Header="OCR 처리 상세" Margin="0,0,0,10">
                <TextBlock x:Name="OcrPipelineTraceText" Text="OCR 시작 후 인식 영역과 제외 사유를 표시합니다. 채팅 원문은 기록하지 않습니다."
                           Foreground="#586A82" FontSize="12" TextWrapping="Wrap" Margin="4,8"/>
              </Expander>
              <Border Background="#F8FAFD" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,9,0,0">
                <TextBlock x:Name="OcrPerformanceText" Text="처리 시간 · 캡처 — · 인식 — · 합의 — · 번역 — · 자동 균형"
                           Foreground="#586A82" FontSize="12" TextWrapping="Wrap"/>
              </Border>
                </StackPanel>
              </Expander>







              
            </StackPanel>
          </Border>
        </Grid>
<Border x:Name="EnginesPage" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="22" Margin="0">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="번역 엔진" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="내 PC에서 번역 · 모델 선택과 설치를 여기서 관리합니다" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,15,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="사용할 번역 방식" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
              <ComboBox x:Name="TranslationProviderCombo" Grid.Column="1" SelectionChanged="TranslationProvider_OnSelectionChanged" ToolTip="처음에는 스마트 복합을 권장합니다. 두 로컬 엔진 중 준비된 경로로 자동 전환합니다.">
                <ComboBoxItem Tag="Hybrid"><TextBlock Style="{StaticResource ComboText}" Text="무료 로컬 · AI 우선 + Lite 대체 · 기본값"/></ComboBoxItem>
                <ComboBoxItem Tag="Lite"><TextBlock Style="{StaticResource ComboText}" Text="Valtrans Lite · 무료 오프라인 · CPU"/></ComboBoxItem>
                <ComboBoxItem Tag="Ollama"><TextBlock Style="{StaticResource ComboText}" Text="로컬 AI · Hy-MT2 / Qwen / TranslateGemma"/></ComboBoxItem>
              </ComboBox>
            </Grid>

            <StackPanel Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="서버·언어권 참고" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
