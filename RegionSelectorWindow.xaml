<Window x:Class="Valtrans.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#55000000"
        Topmost="True" ShowInTaskbar="False" Cursor="Cross" ResizeMode="NoResize"
        KeyDown="Window_OnKeyDown" MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        MouseMove="Window_OnMouseMove" MouseLeftButtonUp="Window_OnMouseLeftButtonUp">
  <Canvas x:Name="RootCanvas">
    <Border x:Name="Selection" Visibility="Collapsed" BorderBrush="#FF4655" BorderThickness="2"
            Background="#18FF4655" CornerRadius="3"/>
    <Border Canvas.Left="24" Canvas.Top="24" Background="#E9121720" CornerRadius="8" Padding="14,9">
      <TextBlock Text="번역할 게임 채팅 영역을 드래그하세요  ·  ESC 취소" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
    </Border>
  </Canvas>
</Window>
