<Window x:Class="Valtrans.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valtrans Overlay" Width="560" Height="210"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Left="40" Top="80" MinWidth="280" MinHeight="90" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="MoveBar" Background="#F0202B43" CornerRadius="9,9,0,0" MinHeight="38">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="Transparent" Cursor="SizeAll" Padding="12,8"
                MouseLeftButtonDown="DragBar_OnMouseLeftButtonDown">
          <TextBlock Text="⠿  드래그해서 이동" Foreground="White" FontSize="13"/>
        </Border>
        <Button Grid.Column="1" Content="완료 · 잠금" Foreground="#0F172A" Background="White"
                Margin="4" Padding="10,4" Click="FinishMove_OnClick"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" x:Name="OverlayRoot" Background="#6011182C" BorderBrush="#704E5D86" BorderThickness="1" CornerRadius="11"
            PreviewMouseLeftButtonDown="DragBar_OnMouseLeftButtonDown">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="15,10">
          <ItemsControl x:Name="TranslationItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="Transparent" CornerRadius="6" Padding="9,7" Margin="0,2">
                  <TextBlock Text="{Binding Translation}" Foreground="White" FontWeight="SemiBold"
                             TextWrapping="Wrap" TextOptions.TextFormattingMode="Ideal"
                             TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <ResizeGrip Grid.Row="1" x:Name="ResizeHandle" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Background="Transparent" ToolTip="드래그해서 크기 조절"
                PreviewMouseLeftButtonDown="ResizeHandle_OnMouseLeftButtonDown">
      <ResizeGrip.Template>
        <ControlTemplate TargetType="ResizeGrip">
          <Grid Background="Transparent">
            <Path Data="M 7,20 L 20,7 M 12,20 L 20,12 M 17,20 L 20,17"
                  Stroke="#E58CCB" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Grid>
        </ControlTemplate>
      </ResizeGrip.Template>
    </ResizeGrip>
  </Grid>
</Window>
