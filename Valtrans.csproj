<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Valtrans</AssemblyName>
    <RootNamespace>Valtrans</RootNamespace>
    <StartupObject>Valtrans.Program</StartupObject>
    <Version>0.5.0-beta</Version>
    <FileVersion>0.5.0.0</FileVersion>
    <Product>Valtrans Game Chat Translator</Product>
    <ApplicationIcon>Assets\Valtrans.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="test/**" />
    <None Remove="test/**" />
    <EmbeddedResource Remove="test/**" />
    <Page Remove="test/**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Ocr\paddle_host.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Ocr\fast_ocr_host.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Ocr\chat_ocr.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Ocr\README.md;Ocr\Setup.ps1;Ocr\Setup-FastOcr.ps1;Ocr\download_model.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\Valtrans.ico" />
    <Resource Include="Assets\Valtrans-mark.png" />
    <Resource Include="Assets\Valtrans-donate.png" />
    <Resource Include="Assets\Fonts\Pretendard-Regular.ttf" />
    <Resource Include="Assets\Fonts\Pretendard-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Pretendard-Bold.ttf" />
    <EmbeddedResource Include="Assets\ValtransLiteHost.exe" LogicalName="Valtrans.Assets.ValtransLiteHost.exe" />
  </ItemGroup>
</Project>
