<Window x:Class="Valtrans.OcrCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 영역 보정" Width="900" Height="650" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" Foreground="#18243B" Loaded="Window_OnLoaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Dashboard.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="130"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="OCR 영역 보정" FontSize="22" FontWeight="Bold" Foreground="#18243B"/>
      <TextBlock x:Name="RegionInfoText" Foreground="#586A82" FontSize="12" Margin="0,5,0,14"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#E8ECF4" BorderBrush="#D5DDEA" BorderThickness="1" CornerRadius="10" Padding="8">
      <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
    </Border>

    <Border Grid.Row="2" Background="White" BorderBrush="#D5DDEA" BorderThickness="1" CornerRadius="9" Margin="0,12,0,0" Padding="10">
      <TextBox x:Name="RecognizedTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
               Foreground="#18243B" FontSize="14"/>
    </Border>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <WrapPanel>
        <Button Content="←" Tag="Left" Click="AdjustRegion_OnClick" Padding="12,6" Margin="0,0,5,5"/>
        <Button Content="→" Tag="Right" Click="AdjustRegion_OnClick" Padding="12,6" Margin="0,0,5,5"/>
        <Button Content="↑" Tag="Up" Click="AdjustRegion_OnClick" Padding="12,6" Margin="0,0,5,5"/>
        <Button Content="↓" Tag="Down" Click="AdjustRegion_OnClick" Padding="12,6" Margin="0,0,12,5"/>
        <Button Content="영역 확대" Tag="Grow" Click="AdjustRegion_OnClick" Padding="11,6" Margin="0,0,5,5"/>
        <Button Content="영역 축소" Tag="Shrink" Click="AdjustRegion_OnClick" Padding="11,6" Margin="0,0,12,5"/>
        <Button Content="추천값 복원" Click="ResetRegion_OnClick" Padding="11,6" Margin="0,0,5,5"/>
        <Button x:Name="RefreshPreviewButton" Content="다시 인식" Click="RefreshPreview_OnClick" Padding="11,6" Margin="0,0,5,5"/>
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="4" Margin="0,10,0,0">
      <TextBlock x:Name="PreviewStatusText" Text="미리보기 준비 중…" Foreground="#586A82" FontSize="11" VerticalAlignment="Center" Margin="0,0,220,0" TextWrapping="Wrap"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Content="취소" Click="Cancel_OnClick" Padding="18,8" Margin="0,0,8,0"/>
        <Button Content="이 영역 사용" Click="UseRegion_OnClick" Padding="18,8" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
